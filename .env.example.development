# LobeChat Development Environment Configuration
# ⚠️ DO NOT USE THESE VALUES IN PRODUCTION!

# Application
APP_URL=http://localhost:3010
INTERNAL_APP_URL=http://localhost:3010

# Allow access to private IP addresses (localhost services) in development
# https://lobehub.com/docs/self-hosting/environment-variables/basic#ssrf-allow-private-ip-address
SSRF_ALLOW_PRIVATE_IP_ADDRESS=1

# Local/self-hosted deployments cannot use LobeHub Market Cloud Sandbox without Market auth.
# Keep this enabled to make generated HTML use local chat artifacts instead of cloud export.
DISABLE_CLOUD_SANDBOX=1

# Secrets (pre-generated for development only)
KEY_VAULTS_SECRET=<base64-32-byte-secret>
AUTH_SECRET=<base64-32-byte-secret>
# Required by OIDC and internal async tasks. Generate with:
# node scripts/generate-oidc-jwk.mjs
# JWKS_KEY='{"keys":[...]}'
AUTH_TRUSTED_ORIGINS=http://localhost:3010,http://<main-app-host>:65385
AUTH_SSO_PROVIDERS=generic-oidc
AUTH_DISABLE_EMAIL_PASSWORD=1
AUTH_GENERIC_OIDC_ID=lobehub
AUTH_GENERIC_OIDC_SECRET=<oidc-client-secret>
AUTH_GENERIC_OIDC_ISSUER=http://<main-app-host>:65385/oidc

# Database (PostgreSQL)
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>
DATABASE_DRIVER=node

# Redis
REDIS_URL=redis://:<redis-password>@<redis-host>:<redis-port>
REDIS_PREFIX=lobechat
REDIS_TLS=0

# S3 Storage (LAN RustFS)
S3_ACCESS_KEY_ID=<s3-access-key>
S3_SECRET_ACCESS_KEY=<s3-secret-key>
S3_ENDPOINT=http://<s3-host>:<s3-api-port>
S3_BUCKET=<s3-bucket>
S3_ENABLE_PATH_STYLE=1
S3_SET_ACL=0

# LLM vision uses base64 to avoid S3 presigned URL issues in development
LLM_VISION_IMAGE_USE_BASE64=1

# Search (SearXNG)
SEARXNG_URL=http://localhost:8180

# Proxy (Optional)
# HTTP_PROXY=http://localhost:7890
# HTTPS_PROXY=http://localhost:7890

# AI Model API Keys (Required for chat functionality)
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_PROXY_URL=https://api.anthropic.com

OPENAI_API_KEY=unused
OPENAI_PROXY_URL=/sub2api
# Keep unset unless the upstream supports /v1/responses.
# OPENAI_ENABLE_RESPONSES_API=1
OPENAI_MODEL_LIST=gpt5.5=GPT-5.5<1050000:reasoning:vision:fc:search>,gpt-image-2
DEFAULT_AGENT_CONFIG="model=gpt5.5;provider=openai;"

# /sub2api/* proxies to this OpenAI-compatible upstream.
SUB2API_PROXY_TARGET=http://<openai-compatible-upstream-host>:<port>
SUB2API_PROXY_TARGET_PREFIX=/v1
# SUB2API_PROXY_API_KEY=<upstream-api-key>

# Upstash QStash / Workflow. Optional for local core chat/image paths, required for
# QStash-backed workflow features.
# QSTASH_REGION=<qstash-region>
# QSTASH_URL=<qstash-url>
# QSTASH_TOKEN=<qstash-token>
# QSTASH_CURRENT_SIGNING_KEY=<qstash-current-signing-key>
# QSTASH_NEXT_SIGNING_KEY=<qstash-next-signing-key>
# EU_CENTRAL_1_QSTASH_URL=<qstash-eu-central-url>
# EU_CENTRAL_1_QSTASH_TOKEN=<qstash-eu-central-token>
# EU_CENTRAL_1_QSTASH_CURRENT_SIGNING_KEY=<qstash-eu-current-signing-key>
# EU_CENTRAL_1_QSTASH_NEXT_SIGNING_KEY=<qstash-eu-next-signing-key>
